# ==============================================================================
# CHICKSUM STOREFRONT — VERCEL ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# In Vercel Project Settings -> Environment Variables, you can configure these.
# NOTE: All variables below have sensible defaults in code. Even if you leave
# them blank on Vercel, the website will build and work 100% out of the box!
# ==============================================================================

# 1. WhatsApp Ordering Number (format: country code + 10 digits without '+' or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919988804146

# 2. Display Phone Number (used for 'Call Us' links)
NEXT_PUBLIC_STORE_PHONE="91 9988804146"

# 3. Store Support Email
NEXT_PUBLIC_STORE_EMAIL=Utkarsh.221005@gmail.com

# 4. Physical Store Address in Varanasi
NEXT_PUBLIC_STORE_ADDRESS="B22/7, Kashmiriganj, Gulriya Mod , Khojwan, Varanasi- 221010"

# 5. Production Website URL (e.g., https://chicksum.vercel.app or https://chicksum.com)
NEXT_PUBLIC_SITE_URL=https://chicksum.com

# 6. Optional: Backend API URL (If deploying the NestJS microservice on Render/Railway)
# If left empty, Next.js automatically uses the built-in fast local catalog.
# NEXT_PUBLIC_API_URL=https://api.chicksum.com/api
